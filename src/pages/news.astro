---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="News">
  <PageHeader
    label="News"
    title="お知らせ"
    description="BLUEWOODからの最新情報をお届けします。"
  />

  <section class="py-24">
    <div class="page-container max-w-3xl">
      <div class="border-t border-line">
        <a
          href="#"
          class="block py-6 border-b border-line hover:bg-surface transition-colors duration-300 group"
        >
          <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-10">
            <time class="text-xs font-semibold text-ink-faint font-display tracking-wider w-24 shrink-0">2026.07.01</time>
            <span class="text-[10px] font-semibold tracking-[0.15em] text-accent border border-accent/30 bg-accent-muted px-2.5 py-1 w-fit uppercase">
              お知らせ
            </span>
            <p class="text-sm font-medium text-ink-muted group-hover:text-accent transition-colors duration-300">
              コーポレートサイトをリニューアルいたしました。
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
