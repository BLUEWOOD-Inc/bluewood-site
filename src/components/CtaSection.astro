---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'お気軽にご相談ください',
  description = 'Webサイト制作のご依頼・ご質問など、お問い合わせをお待ちしております。',
} = Astro.props;
---

<section class="py-24 bg-ink text-white">
  <div class="page-container text-center max-w-2xl mx-auto">
    <p class="text-xs font-bold tracking-[0.3em] text-accent uppercase font-display mb-6">Contact</p>
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">{title}</h2>
    <p class="text-sm text-white/70 leading-relaxed font-medium mb-10">{description}</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-accent text-white px-8 py-3.5 text-xs font-semibold tracking-[0.15em] uppercase hover:bg-white hover:text-ink transition-colors duration-300"
      >
        お問い合わせ
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a
        href="mailto:contact@bluewood.co.jp"
        class="inline-flex items-center gap-2 border border-white/30 text-white px-8 py-3.5 text-xs font-semibold tracking-[0.15em] uppercase hover:border-white transition-colors duration-300"
      >
        contact@bluewood.co.jp
      </a>
    </div>
  </div>
</section>
