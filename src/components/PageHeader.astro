---
interface Props {
  label: string;
  title: string;
  description?: string;
}

const { label, title, description } = Astro.props;
---

<section class="pt-20 pb-12">
  <div class="page-container">
    <p class="text-xs font-bold tracking-[0.3em] text-accent uppercase font-display mb-6">
      {label}
    </p>
    <h1 class="text-3xl md:text-4xl font-bold text-ink tracking-tight leading-snug mb-6">
      {title}
    </h1>
    {description && (
      <p class="text-sm md:text-base text-ink-muted leading-relaxed max-w-2xl font-medium">
        {description}
      </p>
    )}
    <div class="section-rule mt-10"></div>
  </div>
</section>
